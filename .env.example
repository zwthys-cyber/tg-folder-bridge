BOT_TOKEN=your_existing_bot_token
API_ID=123456
API_HASH=your_telegram_api_hash
# Only these Telegram user IDs may import/manage tasks; completed folders are public.
OWNER_IDS=123456789
# Dedicated user account; log in using `python login.py` on your deployment host.
RELAY_USER_ID=123456789
ALLOWED_SOURCE_BOTS=epan,SPXM111_bot
BUTTON_LABELS=获取文件,下载全部,全部下载,下一页,下一组,获取全部,下载文件
DATA_DIR=data
IDLE_SECONDS=45
JOB_TIMEOUT_SECONDS=3600
# Set download_upload to download one file, upload to your bot, then delete it.
TRANSFER_MODE=forward
# GiB: maximum temporary single-file size and minimum remaining disk space.
MAX_MEDIA_FILE_GB=4
MIN_FREE_DISK_GB=10
# HEIC: preserve originals and generate small display images/thumbnails when enabled.
HEIC_PREVIEWS=1
# Try one confirmed reuse of an unprotected original after download cooldown.
REFERENCE_REPAIR=1
# Optional one-time manifest refresh for named tasks; confirmed files are skipped.
# Clear after the requested tasks have started, so a future restart does not repeat it.
SOURCE_REFRESH_ONCE=
# Concurrent 512 KiB parts of the same large file; 1 disables concurrency.
UPLOAD_WORKERS=8
# Large documents: concurrent ranges of the same file; 1 restores SDK download.
DOWNLOAD_WORKERS=8
TRANSFER_PAUSE_SECONDS=0.2
DISPLAY_MODE=document_group
# Download/upload mode only: resume previously active tasks after service restart.
AUTO_RESUME_INTERRUPTED=1
# Hybrid mode requires a deliberate cloud->local migration for this bot first.
BOT_API_BASE=https://api.telegram.org
UPLOAD_BACKEND=relay
# If the local Bot API runs as another user, use a private same-filesystem handoff.
# LOCAL_UPLOAD_DIR=/var/lib/tg-folder-bridge-handoff
# LOCAL_UPLOAD_GROUP=ipazake
# Optional: original bot files included in private metadata backups.
SOUGABOT_DIR=/root/sougabot
BACKUP_DIR=/root/sougabot-backups/scheduled
